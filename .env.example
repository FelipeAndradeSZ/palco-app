# Supabase - Apenas a anon key (segura para client-side, protegida por RLS)
# NUNCA coloque a service_role key aqui
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Opcional no MVP. Necessario para conexoes WebRTC em redes restritas.
VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_credential
